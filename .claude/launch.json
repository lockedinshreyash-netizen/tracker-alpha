{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tracker-alpha-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "score-film",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd film && exec npx remotion studio --no-open --port 3123"
      ],
      "port": 3123
    },
    {
      "name": "tracker-alpha-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "tracker-alpha-notes",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "3010",
        "--strictPort"
      ],
      "port": 3010
    }
  ]
}
