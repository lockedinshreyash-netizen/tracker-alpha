{
  "manifest_version": 3,
  "name": "Tracker Alpha: Lock In New Tab",
  "short_name": "Tracker Alpha",
  "version": "1.0.0",
  "description": "Every new tab shows your streak, today's hours against your goal, your exam countdown and one button to start studying.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "search"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://trackeralpha.in/*",
        "https://www.trackeralpha.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "110"
}
